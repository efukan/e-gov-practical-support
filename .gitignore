.agents/
.archive/
CHROMEWEBSTORE.md
EDGE_ADDONS.md
FIREFOX_ADDONS.md
PROMOTION_GUIDE.md
style-profile.md
node_modules/
assets/
# scripts/ は実験用の使い捨てスクリプト置き場（ローカルパスを含むため非公開）。
# ただし package.json の npm scripts から呼ぶ4本だけは公開する。
scripts/*
!scripts/generate_icons.js
!scripts/generate_promo.js
!scripts/generate_edge_assets.js
!scripts/package_firefox.js
*.zip
.firefox_package_tmp/
.DS_Store

# tests/ 配下は npm test で実行する5本のみを追跡する。
# 一時的な検証用のダンプデータやスクラッチを置いても追跡されない。
tests/*
!tests/smoke_content_scripts.js
!tests/test_tooltip_position.js
!tests/test_law_patterns.js
!tests/test_interactions.js
!tests/test_extension_integrity.js

